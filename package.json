{
    "name": "easy-workspace",
    "description": "DSL easy: a Langium language with a VS Code extension and a browser editor",
    "version": "0.0.1",
    "type": "module",
    "private": true,
    "scripts": {
        "clean": "npm run clean --workspaces",
        "watch": "tsc -b tsconfig.build.json --watch",
        "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "npm run --workspace packages/language langium:generate",
        "langium:watch": "npm run --workspace packages/language langium:watch",
        "test": "npm run --workspace packages/language --workspace packages/dsl-controller --workspace packages/dcr-js-adapter --workspace packages/dcr-solution-adapter --workspace packages/dsl-mcp --workspace packages/chatbot test",
        "dcr-page": "node scripts/dcr-page.mjs --force",
        "predev": "node scripts/dcr-page.mjs",
        "preweb:dev": "node scripts/dcr-page.mjs",
        "web:dev": "npm run dev --workspace packages/web",
        "preweb:build": "node scripts/dcr-page.mjs",
        "web:build": "npm run build --workspace packages/web",
        "dev": "concurrently --names documents,web --prefix-colors blue,magenta --kill-others \"npm run documents --workspace packages/chatbot\" \"npm run dev --workspace packages/web\""
    },
    "devDependencies": {
        "@types/node": "~20.19.43",
        "concurrently": "^9.2.5",
        "shx": "^0.3.4",
        "typescript": "~5.9.3"
    },
    "workspaces": [
        "packages/language",
        "packages/dcr-view",
        "packages/extension",
        "packages/web",
        "packages/dsl-controller",
        "packages/dcr-js-adapter",
        "packages/dcr-solution-adapter",
        "packages/dsl-mcp",
        "packages/chatbot"
    ],
    "allowScripts": {
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true
    },
    "dependencies": {
        "monaco-editor": "0.56.0"
    }
}
