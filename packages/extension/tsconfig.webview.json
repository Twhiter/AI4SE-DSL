// The DCR graph panel's page (src/webview), for the browser: checked on its own, as it imports dcr-view's TypeScript
{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "types": []
    },
    "include": [
        "src/webview/**/*.ts"
    ]
}
