{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "composite": false,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "rootDir": ".",
        "allowImportingTsExtensions": true,
        "erasableSyntaxOnly": true,
        "verbatimModuleSyntax": true
    },
    "include": [
        "src/**/*"
    ]
}
